{% extends 'base.html.twig' %}

{% block title %}Conference Guestbook - {{ conference }}{% endblock %}

{% block body %}
    <h2>{{ conference }}</h2>

    {% if comments|length > 0 %}
        <div>There are {{ comments.getTotalCount() }} comments.</div>

        {% for comment in comments %}
            {% if comment.photofilename %}
                <img src="{{ asset('uploads/photos/' ~ comment.photofilename) }}" style="max-width: 200px" />
            {% endif %}

            <h4>{{ comment.author }}</h4>
            <small>
                {{ comment.createdAt|format_datetime('medium', 'short') }}
            </small>

            <p>{{ comment.text }}</p>
        {% endfor %}

        {% if comments.hasPreviousPage() %}
            <a href="{{ path('conference', {
                slug: conference.slug,
                offset: (comments.getPageNumber() - 2) * constant('App\\Repository\\CommentRepository::COMMENTS_PER_PAGE')
            }) }}">Previous</a>
        {% endif %}
        {% if comments.hasNextPage() %}
            <a href="{{ path('conference', {
                slug: conference.slug,
                offset: comments.getPageNumber() * constant('App\\Repository\\CommentRepository::COMMENTS_PER_PAGE')
            }) }}">Next</a>
        {% endif %}


    {% else %}
        <div>No comments have been posted yet for this conference.</div>
    {% endif %}
{% endblock %}
